{
  "name": "featherspec-studio",
  "displayName": "FeatherSpec Studio",
  "description": "Spec-driven development for GitHub Copilot and Claude Code: see every spec, its plan and next step, and send it to your agent.",
  "version": "0.1.0",
  "publisher": "GregorBiswanger",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "homepage": "https://github.com/GregorBiswanger/featherspec-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GregorBiswanger/featherspec-studio"
  },
  "bugs": {
    "url": "https://github.com/GregorBiswanger/featherspec-studio/issues"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "featherspec",
    "spec-driven development",
    "sdd",
    "spec",
    "specs",
    "specification",
    "requirements",
    "acceptance criteria",
    "plan",
    "planning",
    "kanban",
    "board",
    "ai",
    "ai agent",
    "coding agent",
    "agentic coding",
    "GitHub Copilot",
    "copilot",
    "claude code",
    "claude",
    "context engineering",
    "memory bank",
    "prompt",
    "workflow",
    "project management"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "FeatherSpec Studio only reads files in Restricted Mode: it detects FeatherSpec projects and shows their status, and it never runs workspace code or changes a file.",
      "restrictedConfigurations": [
        "featherspec-studio.assistant"
      ]
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "workspaceContains:AGENTS.md",
    "workspaceContains:.specs",
    "onWebviewPanel:featherspecStudio.main"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "FeatherSpec Studio",
      "properties": {
        "featherspec-studio.showStepTips": {
          "type": "boolean",
          "default": true,
          "description": "Show the session and model tip under the next step and the ? button that explains it."
        },
        "featherspec-studio.modelHints": {
          "type": "object",
          "default": {},
          "description": "Names of your own models, shown in the tip. The Studio names no model itself.",
          "properties": {
            "strong": {
              "type": "string",
              "description": "Your strong model: for specify, clarify, writing a plan, compile and finding a block."
            },
            "fast": {
              "type": "string",
              "description": "Your fast model: for one plan step, a plan report, lifecycle moves and the workflow overview."
            }
          },
          "additionalProperties": false
        },
        "featherspec-studio.assistant": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "copilot",
            "claudeCode"
          ],
          "enumItemLabels": [
            "None: Copy prompt",
            "GitHub Copilot",
            "Claude Code"
          ],
          "enumDescriptions": [
            "Copy the prompt and paste it into any assistant.",
            "Open Copilot's chat with the prompt in its input. Needs the GitHub Copilot Chat extension.",
            "Open a Claude Code tab with the prompt in its input. Needs the Claude Code extension."
          ],
          "description": "Your AI assistant for the next step. Send opens its chat with the prompt in the input and sends nothing; Copy prompt stays in the button's menu. Only assistants whose input the Studio can fill are listed.",
          "scope": "window"
        }
      }
    },
    "commands": [
      {
        "command": "featherspec-studio.open",
        "title": "FeatherSpec Studio: Open",
        "icon": "$(window)"
      },
      {
        "command": "featherspec-studio.openOverview",
        "title": "FeatherSpec Studio: Open Overview"
      },
      {
        "command": "featherspec-studio.openBoard",
        "title": "FeatherSpec Studio: Open Board"
      },
      {
        "command": "featherspec-studio.openPlanMap",
        "title": "FeatherSpec Studio: Open Plan Map"
      },
      {
        "command": "featherspec-studio.copyNextStep",
        "title": "FeatherSpec Studio: Copy Next Step"
      },
      {
        "command": "featherspec-studio.shellAction",
        "title": "FeatherSpec Studio: Run Panel Action"
      },
      {
        "command": "featherspec-studio.setup",
        "title": "FeatherSpec Studio: Set Up FeatherSpec"
      },
      {
        "command": "featherspec-studio.copyMergePrompt",
        "title": "FeatherSpec Studio: Copy Merge Prompt"
      },
      {
        "command": "featherspec-studio.selectProject",
        "title": "FeatherSpec Studio: Select Project"
      },
      {
        "command": "featherspec-studio.refresh",
        "title": "FeatherSpec Studio: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "featherspec-studio.openSettings",
        "title": "FeatherSpec Studio: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "featherspec-studio.selectSpec",
        "title": "Select Spec"
      },
      {
        "command": "featherspec-studio.tree.copyNextStep",
        "title": "Copy Next Step",
        "icon": "$(copy)"
      },
      {
        "command": "featherspec-studio.tree.openSpec",
        "title": "Open Spec"
      },
      {
        "command": "featherspec-studio.tree.openPlan",
        "title": "Open Plan"
      },
      {
        "command": "featherspec-studio.tree.showInPlanMap",
        "title": "Show in Plan Map"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "featherspec-studio",
          "title": "FeatherSpec Studio",
          "icon": "media/studio.svg"
        }
      ]
    },
    "views": {
      "featherspec-studio": [
        {
          "id": "featherspec-studio.navigator",
          "name": "Specs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "featherspec-studio.navigator",
        "contents": "No FeatherSpec project found in this workspace.\nSet up FeatherSpec downloads the latest FeatherSpec release from GitHub and adds its files; existing files are never overwritten.\n[Set up FeatherSpec](command:featherspec-studio.setup)\n[Open setup guide](command:featherspec-studio.shellAction?%5B%22openSetupGuide%22%5D) · [Refresh](command:featherspec-studio.shellAction?%5B%22refresh%22%5D)",
        "when": "featherspec-studio.panelState == S2"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "featherspec-studio.copyMergePrompt",
          "when": "false"
        },
        {
          "command": "featherspec-studio.shellAction",
          "when": "false"
        },
        {
          "command": "featherspec-studio.selectSpec",
          "when": "false"
        },
        {
          "command": "featherspec-studio.tree.copyNextStep",
          "when": "false"
        },
        {
          "command": "featherspec-studio.tree.openSpec",
          "when": "false"
        },
        {
          "command": "featherspec-studio.tree.openPlan",
          "when": "false"
        },
        {
          "command": "featherspec-studio.tree.showInPlanMap",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "featherspec-studio.open",
          "when": "view == featherspec-studio.navigator",
          "group": "navigation@1"
        },
        {
          "command": "featherspec-studio.refresh",
          "when": "view == featherspec-studio.navigator",
          "group": "navigation@2"
        },
        {
          "command": "featherspec-studio.openSettings",
          "when": "view == featherspec-studio.navigator",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "featherspec-studio.tree.copyNextStep",
          "when": "view == featherspec-studio.navigator && viewItem =~ /\\bstep\\b/",
          "group": "inline"
        },
        {
          "command": "featherspec-studio.tree.showInPlanMap",
          "when": "view == featherspec-studio.navigator && viewItem =~ /\\bmap\\b/",
          "group": "spec@0"
        },
        {
          "command": "featherspec-studio.tree.openSpec",
          "when": "view == featherspec-studio.navigator && viewItem =~ /^spec\\b/",
          "group": "spec@1"
        },
        {
          "command": "featherspec-studio.tree.openPlan",
          "when": "view == featherspec-studio.navigator && viewItem =~ /\\bplan\\b/",
          "group": "spec@2"
        },
        {
          "command": "featherspec-studio.tree.copyNextStep",
          "when": "view == featherspec-studio.navigator && viewItem =~ /\\bstep\\b/",
          "group": "spec@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run --project node --project webview && vitest run --project timing-node --project timing-webview --no-file-parallelism --maxWorkers=1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "^1.146.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jsdom": "31.0.1",
    "npm-run-all": "^4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "author": {
    "name": "Gregor Biswanger"
  }
}
