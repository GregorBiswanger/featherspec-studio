{
  "name": "featherspec-studio",
  "displayName": "FeatherSpec Studio",
  "description": "Visual command center for spec-driven development with FeatherSpec: see every spec, control every agent.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "FeatherSpec Studio only reads files in Restricted Mode: it detects FeatherSpec projects and shows their status, and it never runs workspace code or changes a file."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "workspaceContains:AGENTS.md",
    "workspaceContains:.specs",
    "onWebviewPanel:featherspecStudio.main"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "featherspec-studio.open",
        "title": "FeatherSpec Studio: Open"
      },
      {
        "command": "featherspec-studio.openMissionControl",
        "title": "FeatherSpec Studio: Open Mission Control"
      },
      {
        "command": "featherspec-studio.openSpecBoard",
        "title": "FeatherSpec Studio: Open Spec Board"
      },
      {
        "command": "featherspec-studio.openSpecExplorer",
        "title": "FeatherSpec Studio: Open Spec Explorer"
      },
      {
        "command": "featherspec-studio.openAgentCenter",
        "title": "FeatherSpec Studio: Open Agent Center"
      },
      {
        "command": "featherspec-studio.rescan",
        "title": "FeatherSpec Studio: Rescan Project"
      },
      {
        "command": "featherspec-studio.shellAction",
        "title": "FeatherSpec Studio: Run Panel Action"
      },
      {
        "command": "featherspec-studio.selectProject",
        "title": "FeatherSpec Studio: Select Project"
      },
      {
        "command": "featherspec-studio.refreshDiscovery",
        "title": "FeatherSpec Studio: Refresh Project Discovery"
      },
      {
        "command": "featherspec-studio.clearRunHistory",
        "title": "FeatherSpec Studio: Clear Run History"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "featherspec-studio",
          "title": "FeatherSpec Studio",
          "icon": "media/studio.svg"
        }
      ]
    },
    "views": {
      "featherspec-studio": [
        {
          "id": "featherspec-studio.navigator",
          "name": "FeatherSpec Studio"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "featherspec-studio.shellAction",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "FeatherSpec Studio",
      "properties": {
        "featherspec-studio.runHistory.maxAgeDays": {
          "type": "integer",
          "default": 90,
          "minimum": 1,
          "scope": "application",
          "description": "Number of days FeatherSpec Studio keeps ended agent runs, their events and the spec status history. Older data is removed when Studio activates. Runs that are still open are never removed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "^1.146.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jsdom": "31.0.1",
    "npm-run-all": "^4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
