<idea-plugin>
    <id>com.gregorbiswanger.featherspec.studio</id>
    <name>FeatherSpec Studio</name>
    <vendor>Gregor Biswanger</vendor>
    <description>FeatherSpec Studio brings the spec-driven development view of a FeatherSpec project into JetBrains IDEs.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="com.gregorbiswanger.featherspec.studio.panel.StudioEditorProvider"/>
        <postStartupActivity implementation="com.gregorbiswanger.featherspec.studio.StudioStartup"/>
        <postStartupActivity implementation="com.gregorbiswanger.featherspec.studio.probe.ProbeAutoRun"/>
        <toolWindow id="FeatherSpec Studio" anchor="left" icon="/icons/toolWindow.svg" factoryClass="com.gregorbiswanger.featherspec.studio.tree.StudioToolWindowFactory"/>
    </extensions>
</idea-plugin>
