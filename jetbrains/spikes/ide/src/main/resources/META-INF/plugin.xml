<idea-plugin>
    <id>com.gregorbiswanger.featherspec.spike</id>
    <name>FeatherSpec Spike</name>
    <vendor>Gregor Biswanger</vendor>
    <description>FeatherSpec spike: the unchanged webview bundle in a JCEF editor tab, measured for AC-009 S-2.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="com.gregorbiswanger.featherspec.spike.SpikeEditorProvider"/>
    </extensions>
    <actions>
        <action id="FeatherSpecSpike.Open" class="com.gregorbiswanger.featherspec.spike.OpenSpikeAction" text="Open FeatherSpec Spike">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
