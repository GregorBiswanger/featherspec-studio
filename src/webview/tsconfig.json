{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": [],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "rootDir": ".."
    },
    "include": ["./**/*.ts", "./**/*.tsx", "../shared/**/*.ts"]
}
